{
  "name": "futbol",
  "private": true,
  "type": "module",
  "workspaces": ["shared", "backend", "frontend"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "typecheck": "npm run typecheck -w shared -w backend -w frontend",
    "test": "npm test -w backend -w frontend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
